{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "switch",
      "displayName": "Nintendo Switch: the .nro (and the .nsp, target blipblop_nsp)",
      "binaryDir": "${sourceDir}/build/switch",
      "toolchainFile": "$env{DEVKITPRO}/cmake/Switch.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BB_BUILD_TESTS": "OFF",
        "BB_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "default",
      "displayName": "Debug build on a Mac or Linux (tests, tools, editor)",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release build on a Mac or Linux (tests, tools, editor)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug build on a Mac or Linux with AddressSanitizer and UBSan",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BB_SANITIZERS": "address;undefined",
        "BB_POISON_LOCALS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "switch",
      "configurePreset": "switch"
    },
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
